# Supabase — public (safe to expose to the browser; access is gated by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only (bypasses RLS, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API — server-only
ANTHROPIC_API_KEY=
# Optional: override the default model (claude-opus-5)
ANTHROPIC_MODEL=

# Shared secret required on the ingestion route. Vercel Cron sends it
# automatically as `Authorization: Bearer $CRON_SECRET` when this env var is
# named CRON_SECRET; also accepted via the `x-ingest-secret` header for
# manual/local triggering.
CRON_SECRET=
